@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="admin-hero">
    <h1>Admin Dashboard</h1>
    <p>Manage your store, coaches, and users in one place</p>

    <div class="admin-actions">
        <a asp-controller="RacketManagement" asp-action="Create" class="admin-card">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSIi0DXtVY5MaZyb78SgFX9VpIIBalMnjBGhQ&s" alt="Add Racket">
            <h5>Add Racket</h5>
        </a>
        <a asp-controller="BallManagement" asp-action="Create" class="admin-card">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQi11QNgLJ_ED14I2R_XRVirbWZUcgF-rAv8Q&s" alt="Add Ball">
            <h5>Add Balls</h5>
        </a>
        <a asp-controller="BagManagement" asp-action="Create" class="admin-card">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTHnFZqNnxCpfKocfQjiH0uDZsvBvvN9PezWg&s" alt="Add Bag">
            <h5>Add Bag</h5>
        </a>
        <a asp-controller="CoachManagement" asp-action="Add" class="admin-card">
            <img src="https://cdn-icons-png.flaticon.com/512/147/147142.png" alt="Add Coach">
            <h5>Add Coach</h5>
        </a>
        <a asp-controller="UserManagement" asp-action="Index" class="admin-card">
            <img src="https://cdn-icons-png.flaticon.com/512/1256/1256650.png" alt="Manage Users">
            <h5>Manage Users</h5>
        </a>
    </div>
</div>
