@using TennisAcademyApp.ViewModels.Racket
@model RacketDeleteViewModel;

@{
    ViewData["Title"] = "Delete Racket";
}

<h2 class="mb-4 text-center">Are you sure you want to delete this racket?</h2>

<div class="d-flex justify-content-center">
    <div class="card mb-4" style="max-width: 400px; width: 100%;">
        <img src="@Model.ImageUrl" class="card-img-top object-fit-cover" alt="Racket Image" style="height: 250px;" />
        <div class="card-body text-center">
            <h5 class="card-title">@Model.Brand - @Model.Model</h5>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center gap-3">
    <form asp-action="Delete" method="post" class="d-inline">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger px-4">Delete</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
</div>
