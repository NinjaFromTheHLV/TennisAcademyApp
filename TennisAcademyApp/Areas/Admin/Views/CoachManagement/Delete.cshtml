@using TennisAcademyApp.ViewModels.Coach
@model DeleteCoachViewModel

@{
    ViewData["Title"] = "Delete Coach";
}

<div class="delete-card row g-0">
    <div class="col-md-5">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" />
        }
        else
        {
            <img src="https://via.placeholder.com/400x500?text=No+Image" alt="No image" />
        }
    </div>
    <div class="col-md-7">
        <div class="delete-body">
            <h3>Are you sure you want to delete this coach?</h3>

            <p><strong>Name:</strong> @Model.Name</p>

            <form asp-action="Delete" method="post" class="mt-4 delete-actions d-flex gap-3 flex-wrap">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CoachId" />

                <button type="submit" class="btn btn-danger">
                    <span style="font-weight: bold; margin-right: 6px;">&#128465;</span>
                    Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
