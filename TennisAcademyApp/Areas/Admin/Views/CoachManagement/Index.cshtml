@using TennisAcademyApp.ViewModels.Coach
@model PaginatedCoachesViewModel

@{
    ViewData["Title"] = "Coaches";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <a asp-action="Add" class="btn btn-success shadow-sm px-3 py-2">
        <i class="bi bi-plus-circle"></i> Add Coach
    </a>
</div>

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group shadow-sm">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input type="text" name="searchQuery" class="form-control" placeholder="Search by name..." value="@Model.SearchQuery" />
        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="row g-4">
    @foreach (var coach in Model.Coaches)
    {
        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 coach-card">
                <div class="ratio ratio-4x3">
                    <img src="@Url.Content(coach.ImageUrl)" class="card-img-top rounded-top" alt="@coach.CoachName" style="object-fit: cover;" />
                </div>
                <div class="card-body">
                    <h5 class="card-title">@coach.CoachName</h5>
                    <p class="text-muted mb-1"><strong>Age:</strong> @coach.CoachAge</p>
                </div>
                <div class="card-footer bg-transparent border-0 d-flex justify-content-between flex-wrap gap-2">
                    <a asp-action="Edit" asp-route-id="@coach.CoachId" class="btn btn-outline-warning btn-sm">
                        <i class="bi bi-pencil-square"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@coach.CoachId" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination pagination-sm">
            @if (Model.PageNumber > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-searchQuery="@Model.SearchQuery">&laquo;</a>
                </li>
            }
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchQuery="@Model.SearchQuery">@i</a>
                </li>
            }
            @if (Model.PageNumber < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-searchQuery="@Model.SearchQuery">&raquo;</a>
                </li>
            }
        </ul>
    </nav>
}