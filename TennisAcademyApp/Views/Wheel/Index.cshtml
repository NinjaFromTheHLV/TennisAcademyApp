@{
    var requestCulture = Context.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "en";
    var isBg = currentCulture == "bg";

    ViewData["Title"] = isBg ? "Колело на Късмета" : "Wheel of Fortune";
    bool canSpin = ViewBag.CanSpin ?? false;
}

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="wheel-page-container">
    <div class="bg-glow"></div>

    <div class="content-wrap">
        <h1 class="main-title">@(isBg ? "Завърти и Спечели" : "Wheel of Luck")</h1>
        <p class="subtitle">@(isBg ? "Имаш право на 1 завъртане на всеки 7 дни." : "You can spin once every 7 days.")</p>

        <div class="wheel-scene">
            <div class="wheel-pointer"><div class="pointer-inner"></div></div>

            <canvas id="wheelCanvas" width="400" height="400"></canvas>

            @if (canSpin)
            {
                <button id="spinBtnCenter" class="center-btn pulse" onclick="spinWheel()">
                    @(isBg ? "ЗАВЪРТИ" : "SPIN")
                </button>
            }
            else
            {
                <button class="center-btn disabled" disabled>
                    <i class="fa-solid fa-lock"></i>
                </button>
            }
        </div>

        @if (!canSpin)
        {
            <div class="info-box">
                <i class="fa-solid fa-clock-rotate-left" style="color: #ccff00;"></i>
                <span>@(isBg ? "Следващо завъртане:" : "Next spin:")</span>
                <span class="next-date">@ViewBag.NextSpinDate</span>
            </div>
        }
    </div>
</div>

<style>
    :root {
        --accent: #ccff00;
        --bg-dark: #0a0a0a;
        --glass: rgba(255, 255, 255, 0.03);
        --border: rgba(255, 255, 255, 0.1);
    }

    .wheel-page-container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #fff;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px 0;
        position: relative;
    }

    .bg-glow {
        position: absolute;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(204, 255, 0, 0.05) 0%, transparent 70%);
        z-index: 0;
        pointer-events: none;
    }

    .content-wrap {
        position: relative;
        z-index: 1;
        text-align: center;
        width: 100%;
    }

    .main-title {
        font-size: 3rem;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 10px;
        text-shadow: 0 5px 15px rgba(204, 255, 0, 0.3);
    }

    .subtitle {
        font-size: 1.1rem;
        color: #888;
        margin-bottom: 40px;
    }

    .wheel-scene {
        position: relative;
        width: 460px;
        height: 460px;
        margin: 0 auto;
        padding: 30px;
        background: linear-gradient(145deg, #1a1a1a, #000);
        border-radius: 50%;
        box-shadow: 0 20px 80px rgba(0,0,0,0.8), inset 0 0 20px rgba(204, 255, 0, 0.1);
        border: 1px solid var(--border);
    }

    .wheel-pointer {
        position: absolute;
        top: -10px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 100;
        filter: drop-shadow(0 5px 15px rgba(0,0,0,0.5));
    }

    .pointer-inner {
        width: 0;
        height: 0;
        border-left: 20px solid transparent;
        border-right: 20px solid transparent;
        border-top: 45px solid var(--accent);
        position: relative;
    }

        .pointer-inner::after {
            content: '';
            position: absolute;
            top: -45px;
            left: -12px;
            border-left: 12px solid transparent;
            border-right: 12px solid transparent;
            border-top: 25px solid #fff;
        }

    #wheelCanvas {
        border-radius: 50%;
        box-shadow: 0 0 50px rgba(0,0,0,0.5);
        transition: transform 6s cubic-bezier(0.1, 0.9, 0.2, 1);
    }

    .center-btn {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100px;
        height: 100px;
        background: radial-gradient(circle, #fff 0%, var(--accent) 100%);
        border: 8px solid #000;
        border-radius: 50%;
        color: #000;
        font-weight: 900;
        font-size: 1rem;
        cursor: pointer;
        z-index: 50;
        box-shadow: 0 0 20px rgba(204, 255, 0, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
    }

        .center-btn:hover:not(:disabled) {
            transform: translate(-50%, -50%) scale(1.1);
            box-shadow: 0 0 40px var(--accent);
        }

        .center-btn.disabled {
            background: #222;
            color: #555;
            box-shadow: none;
            cursor: not-allowed;
        }

    .pulse {
        animation: breathing 2s infinite ease-in-out;
    }
    @@keyframes breathing {
        0%, 100%

    {
        transform: translate(-50%, -50%) scale(1);
    }

    50% {
        transform: translate(-50%, -50%) scale(1.05);
        box-shadow: 0 0 30px var(--accent);
    }

    }

    .info-box {
        margin-top: 50px;
        background: var(--glass);
        border: 1px solid var(--border);
        padding: 15px 30px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        gap: 12px;
    }

    .next-date {
        color: var(--accent);
        font-weight: 700;
    }

    /* SweetAlert2 */
    .premium-popup {
        border-radius: 20px !important;
        background: #111 !important;
        border: 1px solid var(--border) !important;
        color: #fff !important;
    }

    .win-title {
        color: var(--accent) !important;
        font-weight: 900 !important;
        font-size: 2rem !important;
    }

    .win-btn {
        background: var(--accent) !important;
        color: #000 !important;
        font-weight: 900 !important;
        border-radius: 10px !important;
        padding: 12px 35px !important;
    }
</style>

<script>
    let isSpinning = false;
    const isBg = @isBg.ToString().ToLower();

    const texts = {
        try: isBg ? "ОПИТАЙ ПАК" : "TRY AGAIN",
        win: isBg ? "ПОЗДРАВЛЕНИЯ!" : "CONGRATS!",
        lose: isBg ? "УВИ..." : "OOPS...",
        wonText: isBg ? "Спечели: " : "You won: ",
        btnCart: isBg ? "КЪМ КОЛИЧКАТА" : "TO CART",
        btnOk: isBg ? "РАЗБРАХ" : "GOT IT"
    };

    const canvas = document.getElementById("wheelCanvas");
    const ctx = canvas.getContext("2d");

    const prizes = ["@ViewBag.RacketName", texts.try, "@ViewBag.BallName", texts.try, "@ViewBag.BagName", texts.try];
    const prizeImages = { 0: "@ViewBag.RacketImg", 2: "@ViewBag.BallImg", 4: "@ViewBag.BagImg" };

    function draw() {
        const slice = (Math.PI * 2) / 6;
        ctx.clearRect(0,0,400,400);

        prizes.forEach((p, i) => {
            const angle = i * slice;

            ctx.beginPath();
            ctx.moveTo(200, 200);
            ctx.arc(200, 200, 200, angle, angle + slice);

            const grad = ctx.createRadialGradient(200,200,50, 200,200,200);
            if (i % 2 === 0) {
                grad.addColorStop(0, '#ccff00'); grad.addColorStop(1, '#99cc00');
            } else {
                grad.addColorStop(0, '#1a1a1a'); grad.addColorStop(1, '#000000');
            }
            ctx.fillStyle = grad;
            ctx.fill();
            ctx.strokeStyle = "rgba(255,255,255,0.05)";
            ctx.lineWidth = 2;
            ctx.stroke();

            ctx.save();
            ctx.translate(200, 200);
            ctx.rotate(angle + slice/2);
            ctx.textAlign = "right";
            ctx.fillStyle = (i % 2 === 0) ? "#000" : "#fff";
            ctx.font = "bold 15px Arial";
            ctx.shadowColor = "rgba(0,0,0,0.3)";
            ctx.shadowBlur = 5;
            ctx.fillText(p.substring(0, 15), 180, 5);
            ctx.restore();
        });
    }
    draw();

    function spinWheel() {
        if (isSpinning) return;
        isSpinning = true;
        const btn = document.getElementById('spinBtnCenter');
        btn.disabled = true;
        btn.classList.remove('pulse');

        fetch('@Url.Action("Spin", "Wheel")', { method: 'POST' })
            .then(async r => {
                if (!r.ok) throw new Error(await r.text());
                return r.json();
            })
            .then(data => {
                const sliceDeg = 360 / 6;
                const extraSpins = 10 * 360;
                const randomOffset = Math.random() * 40 - 20;
                const stopAngle = extraSpins + 270 - (data.winningIndex * sliceDeg + (sliceDeg / 2)) + randomOffset;

                canvas.style.transform = `rotate(${stopAngle}deg)`;

                setTimeout(() => {
                    if ([1, 3, 5].includes(data.winningIndex)) {
                        Swal.fire({
                            title: texts.lose,
                            html: `<div style="font-size: 5rem;">☹️</div><p style="opacity: 0.7">Няма късмет този път. Опитай отново след 7 дни!</p>`,
                            confirmButtonText: texts.btnOk,
                            customClass: { popup: 'premium-popup', confirmButton: 'win-btn' }
                        }).then(() => location.reload());
                    } else {
                        Swal.fire({
                            title: texts.win,
                            html: `<h2 style="color:#ccff00; margin: 15px 0;">${data.prize}</h2><p>${texts.wonText}</p>`,
                            imageUrl: prizeImages[data.winningIndex],
                            imageWidth: 200,
                            confirmButtonText: texts.btnCart,
                            customClass: { popup: 'premium-popup', title: 'win-title', confirmButton: 'win-btn' }
                        }).then(() => location.reload());

                        confetti({ particleCount: 250, spread: 80, origin: { y: 0.6 }, colors: ['#ccff00', '#ffffff'] });
                    }
                }, 6200);
            })
            .catch(() => {
                isSpinning = false;
                btn.disabled = false;
                btn.classList.add('pulse');
                alert("Възникна грешка, моля опитайте пак.");
            });
    }
</script>