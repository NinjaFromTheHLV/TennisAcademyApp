<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TennisAcademy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TennisAcademyApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">TennisAcademy</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="coachDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Coaches
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="coachDropdown">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Coach" asp-action="Index">Our Coaches</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="FavouriteCoach" asp-action="Favourite">My Favourite Coaches</a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="reservationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Reservations
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="reservationDropdown">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Reservation" asp-action="Index">My Reservations</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Reservation" asp-action="Create">Reserve</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Reservation" asp-action="ReservationHistory">Reservation History</a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Racket" asp-action="Index">Shop</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="cartDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-cart-fill"></i> Cart
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="cartDropdown">
                                <li><a class="dropdown-item" asp-controller="RacketCart" asp-action="RacketsIndex">Rackets</a></li>
                                <li><a class="dropdown-item" asp-controller="Cart" asp-action="Balls">Balls</a></li>
                                <li><a class="dropdown-item" asp-controller="Cart" asp-action="Outfits">Outfits</a></li>
                            </ul>
                        </li>
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - TennisAcademyApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
