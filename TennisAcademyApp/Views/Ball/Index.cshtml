@using TennisAcademyApp.ViewModels.Ball
@model IEnumerable<BallIndexViewModel>

@{
    ViewData["Title"] = "Balls Shop";
}

<div class="d-flex justify-content-start mb-4">
    <a asp-controller="Racket" asp-action="Index" class="btn btn-outline-primary me-2">Rackets</a>
    <a asp-controller="Ball" asp-action="Index" class="btn btn-outline-primary me-2">Balls</a>
    <a asp-controller="Bag" asp-action="Index" class="btn btn-outline-primary me-2">Bags</a>
</div>

<div class="mb-4 text-end">
    <a asp-controller="Ball" asp-action="Create" class="btn btn-primary px-4 py-2">
        <i class="bi bi-plus-lg"></i> Add a Ball
    </a>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var ball in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm d-flex flex-column">
                <img src="@ball.ImageUrl" class="card-img-top object-fit-cover" alt="Ball Image" style="height: 315px;" />

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@ball.Brand - @ball.Model</h5>
                    <p class="card-text">Price: <strong>@ball.Price.ToString("C")</strong></p>
                    <p class="card-text">In stock: @ball.Quantity</p>

                    <div class="row mt-auto">
                        <div class="col-6 pe-1">
                            <a asp-action="Edit" asp-route-id="@ball.Id" class="btn btn-outline-warning w-100">Edit</a>
                        </div>
                        <div class="col-6 ps-1">
                            <a asp-action="Delete" asp-route-id="@ball.Id" class="btn btn-outline-danger w-100">Delete</a>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-transparent border-0">
                    @if (ball.Quantity > 0)
                    {
                        <form asp-controller="BallCart" asp-action="AddBallToCart" method="post" class="d-flex flex-column align-items-stretch gap-2">
                            <input type="hidden" name="ballId" value="@ball.Id" />

                            <div class="input-group">
                                <input type="number" name="quantity" class="form-control" value="1" min="1" max="@ball.Quantity" />
                                <button type="submit" class="btn btn-primary">Add to Cart</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100" disabled>Out of Stock</button>
                    }
                </div>
            </div>
        </div>
    }
</div>
