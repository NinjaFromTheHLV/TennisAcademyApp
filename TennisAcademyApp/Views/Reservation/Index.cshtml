@using TennisAcademyApp.ViewModels.Reservation;
@model IEnumerable<ReservationIndexViewModel>

@{
    ViewData["Title"] = "My Reservations";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show w-100 rounded-0 text-center mb-0" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show w-100 rounded-0 text-center mb-0" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2 class="mb-4">My Reservations</h2>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">You have no reservations yet.</div>
}
else
{
    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>Date & Time</th>
                <th>Coach</th>
                <th>Training Type</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Date</td>
                    <td>@r.CoachName</td>
                    <td>@r.TrainingTypeName</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@r.ReservationId" class="btn btn-info btn-sm">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
