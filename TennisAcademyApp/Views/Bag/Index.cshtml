@using static TennisAcademyApp.GCommon.Validations.ValidationConstants
@using TennisAcademyApp.ViewModels.Bag
@model IEnumerable<BagIndexViewModel>

@{
    ViewData["Title"] = "Bags Shop";
}

<h1 class="text-center display-5 fw-semibold my-4">Tennis Bags Shop</h1>

<div class="d-flex justify-content-center my-4 gap-4">
    <a asp-controller="Racket" asp-action="Index" class="btn btn-outline-primary d-flex align-items-center gap-2 px-4 py-2">
        <i class="bi bi-activity"></i> Rackets
    </a>
    <a asp-controller="Ball" asp-action="Index" class="btn btn-outline-primary d-flex align-items-center gap-2 px-4 py-2">
        <i class="bi bi-record-circle"></i> Balls
    </a>
    <a asp-controller="Bag" asp-action="Index" class="btn btn-outline-primary d-flex align-items-center gap-2 px-4 py-2">
        <i class="bi bi-backpack2"></i> Bags
    </a>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var bag in Model)
    {
        <div class="col">
            <div class="card h-100 shadow rounded-4 d-flex flex-column">
                <img src="@bag.ImageUrl" class="card-img-top object-fit-cover rounded-top-4" alt="Bag Image" style="height: 330px;" />

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@bag.Brand - @bag.Model</h5>
                    <p class="card-text text-muted mb-1">Price: <strong>@bag.Price.ToString("C")</strong></p>
                    <p class="card-text small">In stock: @bag.Quantity</p>
                </div>

                <div class="card-footer bg-transparent border-0">
                    @if (bag.Quantity > 0)
                    {
                        <form asp-controller="BagCart" asp-action="AddBagToCart" method="post" class="d-flex flex-column align-items-stretch gap-2">
                            <input type="hidden" name="id" value="@bag.Id" />

                            <div class="input-group">
                                <input type="number" name="quantity" class="form-control" value="1" min="1" max="@bag.Quantity" />
                                <button type="submit" class="btn btn-primary">Add to Cart</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100" disabled>Out of Stock</button>
                    }
                </div>
            </div>
        </div>
    }
</div>
