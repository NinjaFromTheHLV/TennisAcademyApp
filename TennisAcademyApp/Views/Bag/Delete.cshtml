@using TennisAcademyApp.ViewModels.Bag
@model BagDeleteViewModel

@{
    ViewData["Title"] = "Delete Bag";
}

<h2 class="text-center text-danger mb-4">Delete Bag</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-body text-center">
                <h5 class="card-title mb-3">@Model.Brand - @Model.Model</h5>
                <img src="@Model.ImageUrl" alt="Bag Image" class="img-fluid mb-3 rounded" style="max-height: 300px;" />
                <p class="text-danger fw-bold">Are you sure you want to delete this bag?</p>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
