@using TennisAcademyApp.ViewModels.Cart;
@model IEnumerable<RacketCartViewModel>

@{
    ViewData["Title"] = "Shopping Cart";
}

<h2 class="mb-4">Your Racket Cart</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Your cart has no rackets.</div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-12">
                <div class="card shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1">@item.Brand @item.Model</h5>
                            <small>Quantity: @item.Quantity</small><br />
                            <small>Price per unit: @item.Price.ToString("C")</small>
                        </div>
                        <div class="text-end">
                            <p class="fw-bold mb-2">Total: @item.TotalPrice.ToString("C")</p>
                            <form asp-action="RemoveRacketFromCart" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <hr class="my-4" />
    <div class="text-end">
        <a asp-action="RacketCheckout" class="btn btn-success mt-3">Checkout</a>
    </div>
}
