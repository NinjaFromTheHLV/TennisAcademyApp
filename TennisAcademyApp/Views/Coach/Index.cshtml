@using TennisAcademyApp.ViewModels.Coach;
@model PaginatedCoachesViewModel

@{
    ViewData["Title"] = "Coaches";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Check out our coaches!</h2>
</div>

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchQuery" class="form-control" placeholder="Search for a coach by name..." value="@Model.SearchQuery" />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var coach in Model.Coaches)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@Url.Content(coach.ImageUrl)"
                     class="img-fluid"
                     alt="@coach.CoachName"
                     style="height: 380px; object-fit: cover; width: 100%;" />

                <div class="card-body">
                    <h5 class="card-title">@coach.CoachName</h5>
                    <p class="card-text">
                        <strong>Age:</strong> @coach.CoachAge<br/>
                    </p>
                </div>
                <div class="card-footer text-end">
                    <a asp-action="Details" asp-route-id="@coach.CoachId" class="btn btn-primary px-4 py-2 fs-5">Details</a>
                </div>
            </div>
        </div>
    }
</div>
@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@Model.SearchQuery">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}