@using TennisAcademyApp.ViewModels.Coach;
@model PaginatedCoachesViewModel

@{
    ViewData["Title"] = "Coaches";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show w-100 rounded-0 text-center mb-0" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show w-100 rounded-0 text-center mb-0" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Check out our coaches!</h2>
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <a asp-action="Add" class="btn btn-success d-flex align-items-center justify-content-center gap-2" style="line-height: 1.2;">
            <span style="font-size: 1.75rem; font-weight: bold; display: inline-block; transform: translateY(-1px);">&#43;</span>
            <span style="font-size: 1rem;">Add New Coach</span>
        </a>
    }
</div>

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchQuery" class="form-control" placeholder="Search for a coach by name..." value="@Model.SearchQuery" />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var coach in Model.Coaches)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(coach.ImageUrl))
                {
                    <img src="@Url.Content(coach.ImageUrl)"
                         class="img-fluid"
                         alt="@coach.CoachName"
                         style="height: 380px; object-fit: cover; width: 100%;" />
                }
                else
                {
                    <img src="https://via.placeholder.com/600x250?text=No+Image"
                         class="card-img-top mx-auto d-block"
                         alt="No image" />
                }
                <div class="card-body">
                    <h5 class="card-title">@coach.CoachName</h5>
                    <p class="card-text">
                        <strong>Age:</strong> @coach.CoachAge<br/>
                        <strong>Description:</strong><br />
                        @coach.Description
                    </p>
                </div>
                <div class="card-footer text-end">
                    <a asp-action="Details" asp-route-id="@coach.CoachId" class="btn btn-primary px-4 py-2 fs-5">Details</a>
                </div>
            </div>
        </div>
    }
</div>
@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@Model.SearchQuery">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}