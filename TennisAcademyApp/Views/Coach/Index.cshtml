@using TennisAcademyApp.ViewModels.Coach;
@model PaginatedCoachesViewModel

@{
    var requestCulture = ViewContext.HttpContext.Features.Get<Microsoft.AspNetCore.Localization.IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "en";
    var isBg = currentCulture == "bg";

    ViewData["Title"] = isBg ? "Треньорски състав" : "Coaches";
}

<div class="text-center my-4">
    <h2 class="fw-semibold display-6">@(isBg ? "Запознайте се с нашите треньори!" : "Meet Our Professional Coaches!")</h2>
    <p class="text-muted small">@(isBg ? "Открийте перфектния ментор за вашата игра" : "Find the perfect mentor to elevate your game")</p>
</div>

<div class="row justify-content-center mb-5">
    <div class="col-md-8 col-lg-6">
        <form asp-action="Index" method="get">
            <div class="input-group shadow-sm">
                <span class="input-group-text border-0 bg-card text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text"
                       name="searchQuery"
                       class="form-control border-0"
                       placeholder="@(isBg ? "Търсене на треньор по име..." : "Search for a coach by name...")"
                       value="@Model.SearchQuery" />
                <button type="submit" class="btn btn-primary px-4">@(isBg ? "Търси" : "Search")</button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a asp-action="Index" class="btn btn-secondary">@(isBg ? "Изчисти" : "Clear")</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var coach in Model.Coaches)
    {
        <div class="col">
            <div class="card h-100 shadow border-0 d-flex flex-column">
                <div class="position-relative overflow-hidden rounded-top-4">
                    <img src="@Url.Content(coach.ImageUrl)"
                         class="card-img-top object-fit-cover"
                         alt="@coach.CoachName"
                         style="height: 380px; width: 100%;" />
                </div>

                <div class="card-body d-flex flex-column text-center">
                    <h4 class="card-title fw-bold mb-3">@(isBg ? (coach.CoachNameBg ?? coach.CoachName) : coach.CoachName)</h4>

                    <div class="d-flex justify-content-center gap-3 text-muted small mb-4 mt-auto">
                        <span><i class="bi bi-calendar3 text-primary"></i> @coach.CoachAge @(isBg ? "години" : "years old")</span>
                    </div>

                    <a asp-action="Details" asp-route-id="@coach.CoachId" class="btn btn-outline-primary w-100 py-2">
                        <i class="bi bi-info-circle me-2"></i>@(isBg ? "Виж Детайли" : "View Details")
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-center mt-5">
        <ul class="pagination gap-1">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link border-0 rounded-3 shadow-sm px-3 py-2"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@Model.SearchQuery">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>
}