@using TennisAcademyApp.ViewModels.Coach;
@model CoachDetailsViewModel;

@{
    ViewData["Title"] = "Coach Details";
}

<div class="coach-card mb-5 mt-4">
    <div class="row g-0">
        <div class="col-md-5">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid h-100" alt="@Model.CoachName" />
            }
            else
            {
                <img src="https://via.placeholder.com/300x400?text=No+Image" class="img-fluid h-100" alt="No image" />
            }
        </div>
        <div class="col-md-7">
            <div class="card-body d-flex flex-column justify-content-between h-100">
                <div>
                    <h3 class="card-title mb-3">@Model.CoachName</h3>
                    <p class="mb-2"><strong>Age:</strong> @Model.CoachAge</p>
                    <p><strong>Description:</strong><br />@Model.Description</p>
                    <p class="mb-2"><strong>Nationality:</strong> @Model.Nationality</p>
                </div>

                <div class="mt-4 d-flex flex-wrap gap-2">
                    @if (Model.IsAddedBy)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.CoachId" class="btn btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@Model.CoachId" class="btn btn-danger">Delete</a>
                    }
                    @if (Model.IsAddedBy == false && this.User?.Identity?.IsAuthenticated == true && Model.IsInUserFavorites == false)
                    {
                        <form asp-action="AddToFavourites" asp-route-id="@Model.CoachId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-warning">Add to favourites</button>
                        </form>
                    }
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
