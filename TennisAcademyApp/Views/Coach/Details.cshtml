@using TennisAcademyApp.ViewModels.Coach;
@model CoachDetailsViewModel;

@{
    ViewData["Title"] = "Coach Details";
}

<div class="coach-card mb-5 mt-4">
    <div class="row g-0">
        <div class="col-md-5">
            <img src="@Url.Content(Model.ImageUrl)" alt="Coach image" class="img-fluid" />
        </div>
        <div class="col-md-7">
            <div class="card-body d-flex flex-column justify-content-between h-100">
                <div>
                    <h3 class="card-title mb-3">@Model.CoachName</h3>
                    <p class="mb-2"><strong>Age:</strong> @Model.CoachAge</p>
                    <p><strong>Description:</strong><br />@Model.Description</p>
                    <p class="mb-2"><strong>Nationality:</strong> @Model.Nationality</p>
                </div>

                <div class="mt-4 d-flex flex-wrap gap-2">
                    @if (User?.Identity?.IsAuthenticated == true && Model.IsInUserFavorites == false)
                    {
                        <form asp-controller="FavouriteCoach" asp-action="AddToFavourites" asp-route-id="@Model.CoachId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-warning">Add to favourites</button>
                        </form>
                    }
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
